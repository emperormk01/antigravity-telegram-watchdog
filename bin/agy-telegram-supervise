#!/usr/bin/env bash
# Probe-based supervisor for the AGY Telegram gateway.
# Mirrors opencode-telegram-supervise: idempotent, single-instance, safe to
# launch on every daemon boot. Single process, no local server.
set -u
umask 077

ROOT=/workspace/agy-trial
RUN="$ROOT/run"
LOG="$ROOT/logs"
SUP_PID="$RUN/supervisor.pid"
GATEWAY_PID="$RUN/agy-gateway.pid"
BOT_DIR="$ROOT/agy-telegram"
ENV_FILE="$BOT_DIR/.env"
NODE_BIN=/workspace/runtime/node/bin/node
INTERVAL=${AGY_TELEGRAM_SUPERVISOR_INTERVAL:-60}
FAIL_COUNT=0

mkdir -p "$RUN" "$LOG"

log() {
  echo "[$(date -Is)] $*" >> "$LOG/supervisor.log"
}

proc_cmdline() {
  local pid="$1"
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline"
}

is_supervisor_pid() {
  local pid="$1" cmd
  cmd="$(proc_cmdline "$pid" 2>/dev/null || true)"
  [[ "$cmd" == *"agy-telegram-supervise"* ]]
}

pid_alive() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  local file="$1" value=""
  [ -r "$file" ] || return 1
  value="$(cat "$file" 2>/dev/null || true)"
  case "$value" in
    ''|*[!0-9]*) return 1 ;;
    *) printf '%s\n' "$value" ;;
  esac
}

bot_token() {
  [ -r "$ENV_FILE" ] || return 1
  grep -E '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | tail -1 | cut -d= -f2-
}

# Only one supervisor may own this runtime. A stale PID file is harmless.
if old="$(read_pid "$SUP_PID" || true)"; then
  if pid_alive "$old" && is_supervisor_pid "$old" && [ "$old" != "$$" ]; then
    exit 0
  fi
fi
echo "$$" > "$SUP_PID"

shutdown() {
  rm -f "$SUP_PID"
  exit 0
}
trap shutdown INT TERM EXIT

gateway_process_ok() {
  local pid cmd cwd
  pid="$(read_pid "$GATEWAY_PID" || true)"
  [ -n "$pid" ] || return 1
  pid_alive "$pid" || return 1
  cmd="$(proc_cmdline "$pid" 2>/dev/null || true)"
  # cmdline is bare ("node dist/cli.js"); the cwd disambiguates from the
  # opencode bridge, which runs the same filename elsewhere.
  [[ "$cmd" == *"dist/cli.js"* ]] || return 1
  cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
  [ "$cwd" = "$BOT_DIR" ]
}

# Adopt a live gateway started outside the supervisor (e.g. manual trial).
adopt_foreign_gateway() {
  local pid
  pid="$(pgrep -f "node dist/cli.js" 2>/dev/null | head -1 || true)"
  [ -n "$pid" ] || return 1
  local cwd
  cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
  [ "$cwd" = "$BOT_DIR" ] || return 1
  echo "$pid" > "$GATEWAY_PID"
  log "adopted running gateway pid $pid"
  return 0
}

telegram_ok() {
  local tok
  tok="$(bot_token || true)"
  [ -n "$tok" ] || return 1
  curl -fsS --max-time 10 "https://api.telegram.org/bot${tok}/getMe" >/dev/null 2>&1
}

stop_gateway() {
  local pid
  pid="$(read_pid "$GATEWAY_PID" || true)"
  [ -n "$pid" ] || { rm -f "$GATEWAY_PID"; return; }
  if pid_alive "$pid"; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      pid_alive "$pid" || break
      sleep 1
    done
    pid_alive "$pid" && kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  rm -f "$GATEWAY_PID"
}

start_gateway() {
  if gateway_process_ok; then
    return 0
  fi
  if [ -r "$GATEWAY_PID" ]; then
    stop_gateway
  elif adopt_foreign_gateway; then
    return 0
  fi
  if [ ! -r "$ENV_FILE" ]; then
    log "missing $ENV_FILE; cannot start gateway"
    return 1
  fi
  # Back off when restarts come in bursts (bad token, dead network).
  local now last_gap
  now="$(date +%s)"
  last_gap=$(( now - ${LAST_START:-0} ))
  if [ "$last_gap" -lt 120 ]; then
    FAIL_COUNT=$(( FAIL_COUNT + 1 ))
  else
    FAIL_COUNT=0
  fi
  LAST_START="$now"
  if [ "$FAIL_COUNT" -ge 3 ]; then
    log "gateway failing repeatedly ($FAIL_COUNT); backing off 5m"
    sleep 300
    FAIL_COUNT=0
  fi
  log "starting AGY Telegram gateway"
  (
    cd "$BOT_DIR" || exit 1
    export HOME=/data/agy-home2
    export AGY_CLI_DISABLE_AUTO_UPDATE=true
    export PATH="/workspace/runtime/node/bin:/usr/bin:/bin"
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
    setsid nohup "$NODE_BIN" dist/cli.js >> "$LOG/agy-gateway.log" 2>&1 < /dev/null &
    echo "$!" > "$GATEWAY_PID"
  )
}

# Converge quickly on first boot.
for _ in 1 2 3 4 5 6; do
  start_gateway
  gateway_process_ok && break
  sleep 5
done

while :; do
  if ! gateway_process_ok; then
    log "gateway process down; converging"
    start_gateway
  elif ! telegram_ok; then
    log "Telegram getMe probe failed; restarting gateway"
    stop_gateway
    start_gateway
  else
    echo "[$(date -Is)] OK: gateway running" >> "$LOG/supervisor.log"
  fi
  sleep "$INTERVAL"
done
